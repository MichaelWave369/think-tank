# Frontend: optional override. Default is http://127.0.0.1:3691
VITE_PROVIDER_BRIDGE_URL=http://127.0.0.1:3691

# Local bridge listener
THINK_TANK_BRIDGE_HOST=127.0.0.1
THINK_TANK_BRIDGE_PORT=3691

# Optional exact browser origin(s), comma separated.
# Localhost/127.0.0.1 origins are allowed automatically.
# For a deployed UI, set its exact HTTPS origin here before starting the local bridge.
THINK_TANK_ORIGIN=

# Machine evidence retrieval guardrails
# Successful bodies larger than this are rejected and never enter the evidence packet.
EVIDENCE_MAX_BYTES=2000000
EVIDENCE_MAX_REDIRECTS=3

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Maximum generated tokens per provider turn. Keep this conservative for cost/control.
PROVIDER_MAX_OUTPUT_TOKENS=1200

# Remote providers are deliberately disabled until BOTH key and model are set.
# ChatGPT Plus/Pro subscriptions are separate from API billing/credentials.
OPENAI_API_KEY=
OPENAI_MODEL=

KIMI_API_KEY=
KIMI_MODEL=
KIMI_BASE_URL=https://api.moonshot.ai/v1
