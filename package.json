{
  "name": "phi-think-tank",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "bridge": "node scripts/provider-bridge.mjs",
    "bridge:check": "node --check scripts/provider-bridge.mjs",
    "bridge:test": "node --test scripts/evidence-verifier.node.mjs scripts/dossier-transparency.node.mjs scripts/dossier-witness.node.mjs scripts/dossier-rfc3161.node.mjs scripts/dossier-publication.node.mjs scripts/release-seal.node.mjs scripts/release-rfc3161.node.mjs scripts/release-publication.node.mjs scripts/release-durability.node.mjs",
    "dossier:keygen": "node scripts/generate-dossier-key.mjs",
    "release:keygen": "node scripts/generate-release-key.mjs",
    "witness:keygen": "node scripts/generate-witness-key.mjs",
    "witness:sign": "node scripts/sign-transparency-checkpoint.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.6.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
